# --- App ---
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000

# --- Database (Supabase Postgres connection string) ---
# Use the "Session pooler" or direct connection string from Supabase project settings.
DATABASE_URL=postgresql+psycopg2://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Rate limiting ---
LOGIN_RATE_LIMIT=5/minute

# --- CORS (comma-separated in Railway; JSON list works locally via python-dotenv) ---
ALLOWED_ORIGINS=["https://yourapp.up.railway.app"]

# --- PayHero ---
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_URL=https://yourapp.up.railway.app/api/payhero/callback
PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@christech.co.ke
SMTP_FROM_NAME=Rental Management
SMTP_USE_TLS=true

# --- Company info (shown on receipts/invoices) ---
COMPANY_NAME=Christech Rentals
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_ADDRESS=
