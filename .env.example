# --- App ---
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000

# --- Database (Supabase Postgres connection string) ---
# Use the "Session pooler" or direct connection string from Supabase project settings.
DATABASE_URL=postgresql+psycopg2://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Rate limiting ---
LOGIN_RATE_LIMIT=5/minute

# --- CORS (set as a JSON list string in Render's env var UI) ---
# Required — must list your real domain(s). No wildcard default: combined with
# credentials on the auth cookie, a "*" here would let any site make
# authenticated requests. The app refuses to start in production if this is
# empty or "*".
ALLOWED_ORIGINS=["https://yourapp.onrender.com"]

# --- PayHero ---
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_URL=https://yourapp.onrender.com/api/webhooks/payhero
PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2
# Required in production. PayHero's callback payload isn't signed, so this
# secret is appended as a query param to the callback URL we hand PayHero and
# checked on the way back in — without it, anyone who observes/guesses a
# checkout_request_id could fake a "payment successful" callback.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PAYHERO_WEBHOOK_SECRET=

# --- File storage ---
# "local" writes to disk inside the container — fine for local dev, but
# most PaaS containers (Render, Railway, etc.) are ephemeral, so anything
# saved this way (property images, generated receipts) is lost on every
# redeploy/restart.
# Use "s3" in production, pointed at any S3-compatible bucket.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@christech.co.ke
SMTP_FROM_NAME=Rental Management
SMTP_USE_TLS=true

# --- Company info (shown on receipts/invoices) ---
COMPANY_NAME=Christech Rentals
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_ADDRESS=
